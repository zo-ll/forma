{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".build",
    "types": [
      "node"
    ],
    "tsBuildInfoFile": ".build/node.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts",
    "examples/**/*.ts",
    "apps/mobile/src/forms/index.ts"
  ],
  "references": [
    {
      "path": "packages/core"
    },
    {
      "path": "packages/adapters"
    },
    {
      "path": "packages/mobile-host"
    }
  ]
}
