{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm run build && node --test .build/tests/*.test.js",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "demo": "npm run build && node .build/examples/workouts.js",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
